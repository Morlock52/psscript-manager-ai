{
  "name": "psscript-manager-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PowerShell Script Management Application with AI Analysis",
  "workspaces": [
    "src/frontend",
    "src/backend",
    "src/executor"
  ],
  "scripts": {
    "frontend:dev": "npm run dev -w psscript-frontend",
    "backend:dev": "npm run dev -w psscript-backend",
    "ai:dev": "cd src/ai && python -m uvicorn main:app --reload",
    "dev": "concurrently \"npm:frontend:dev\" \"npm:backend:dev\" \"npm:ai:dev\"",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "lint:fix": "npm run lint:fix -ws --if-present",
    "test": "npm test -ws --if-present"
  },
  "keywords": [
    "powershell",
    "script",
    "management",
    "ai",
    "analysis"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/winston": "^2.4.4",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "winston": "^3.17.0"
  }
}
